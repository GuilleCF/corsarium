---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { parseExpeditionId } from "@/lib/expeditions";

const steps = [
    {
        title: "Choose a voyage",
        text: "Begin from zero with Foundations, or jump in at the voyage you want to learn or review.",
    },
    {
        title: "Learn step by step",
        text: "Each expedition builds on the previous one, introducing concepts before the tools that use them.",
    },
    {
        title: "Apply the tools",
        text: "Run the analyses yourself, with the same tools researchers use.",
    },
];

// Each icon is the inner markup of a 24×24 line icon; the <svg> wrapper sets size, stroke and color
const audiences = [
    {
        title: "New to the field",
        text: "Start with no prior knowledge. Foundations introduces the biology and protein structure behind the simulations, one step at a time.",
        // Compass: finding your bearings
        icon: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
        panel: "bg-surface-cool",
    },
    {
        title: "Already working in the field",
        text: "Learn new analyses and tools, or cross-check what you already know against a clear, structured guide.",
        // Map: charting your own course
        icon: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14"/><path d="M15 6v14"/>',
        panel: "border border-border bg-surface",
    },
];

// "What you’ll learn" is the list of real voyages, so it can't promise a course that doesn't exist
const voyages = (await getCollection("voyages")).sort((a, b) => a.data.order - b.data.order);
const expeditions = await getCollection("expeditions");

function expeditionCount(voyageId: string) {
    return expeditions.filter((entry) => parseExpeditionId(entry.id).voyage === voyageId).length;
}
---

<BaseLayout title="Corsarium | Learn structural bioinformatics" description="An open platform for learning structural bioinformatics, from the foundations to molecular dynamics.">
    <Hero />

    <Section tone="alt" labelledby="learn-heading">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
                <SectionHeading id="learn-heading">What you’ll learn</SectionHeading>
                <p class="mt-4 text-lg text-foreground-secondary">
                    Corsarium is organized into voyages. Each voyage is a path through one area of knowledge, made of expeditions you take in order.
                </p>
            </div>
            <a href="/voyages" class="font-medium text-accent-hover underline-offset-4 hover:underline">
                All voyages <span aria-hidden="true">→</span>
            </a>
        </div>

        {/* Each voyage is a stop on the route: vertical on small screens, horizontal from lg */}
        <ol class="mt-12 grid gap-6 lg:grid-cols-3">
            {voyages.map((voyage, index) => {
                const count = expeditionCount(voyage.id);

                return (
                    <li class="relative flex gap-5 not-last:after:absolute not-last:after:top-14 not-last:after:-bottom-4 not-last:after:left-[22px] not-last:after:w-1 not-last:after:route-y lg:flex-col lg:not-last:after:top-[22px] lg:not-last:after:right-[-1.5rem] lg:not-last:after:bottom-auto lg:not-last:after:left-16 lg:not-last:after:h-1 lg:not-last:after:w-auto lg:not-last:after:route-x">
                        <span aria-hidden="true" class="grid h-12 w-12 shrink-0 place-items-center rounded-full border-2 border-route bg-background font-display text-lg font-semibold text-route">
                            {index + 1}
                        </span>
                        <Card class="group relative flex flex-1 flex-col transition-colors hover:border-accent has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-accent">
                            <h3 class="font-display text-xl font-semibold text-foreground">
                                {/* The ::after covers the whole card, so the full card is clickable while only the title is the link text */}
                                <a
                                    href={`/voyages/${voyage.id}`}
                                    class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-hidden group-hover:text-accent"
                                >
                                    {voyage.data.title}
                                </a>
                            </h3>
                            <p class="mt-3 text-foreground-muted">{voyage.data.description}</p>
                            {/* mt-auto keeps the status on the bottom edge, so it lines up across cards of different heights */}
                            <div class="mt-auto pt-5">
                                {count === 0 ? (
                                    <p class="inline-flex rounded-full border border-border bg-surface-alt px-3 py-1 text-xs font-medium text-foreground-secondary">
                                        Coming soon
                                    </p>
                                ) : (
                                    <p class="text-sm font-medium text-accent">
                                        {count} {count === 1 ? "expedition" : "expeditions"}
                                    </p>
                                )}
                            </div>
                        </Card>
                    </li>
                );
            })}
        </ol>
    </Section>

    <Section labelledby="how-heading">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
            <div>
                <SectionHeading id="how-heading">How it works</SectionHeading>
                <p class="mt-4 max-w-md text-lg text-foreground-secondary">
                    Voyages go from first steps to advanced topics, so you can start where you are.
                </p>
            </div>

            {/* The dotted line between the markers continues the sea route from the hero illustration */}
            <ol class="grid max-w-xl gap-10">
                {steps.map((step, index) => (
                    <li class="relative flex gap-5 not-last:after:absolute not-last:after:top-14 not-last:after:-bottom-8 not-last:after:left-[22px] not-last:after:w-1 not-last:after:route-y">
                        <span aria-hidden="true" class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-accent-warm font-display text-lg font-semibold text-background">
                            {index + 1}
                        </span>
                        <div class="pt-2.5">
                            <h3 class="font-display text-xl font-semibold text-foreground">{step.title}</h3>
                            <p class="mt-2 text-foreground-muted">{step.text}</p>
                        </div>
                    </li>
                ))}
            </ol>
        </div>
    </Section>

    <Section tone="alt" labelledby="audience-heading">
        <div class="max-w-2xl">
            <SectionHeading id="audience-heading">Who it’s for</SectionHeading>
            <p class="mt-4 text-lg text-foreground-secondary">
                Corsarium will guide you through structural bioinformatics, whether you are just starting out or already working in the field.
            </p>
        </div>

        <ul class="mt-10 grid gap-6 md:grid-cols-2">
            {audiences.map((audience) => (
                <li class:list={["rounded-2xl p-8 sm:p-10", audience.panel]}>
                    <svg
                        class="h-8 w-8 text-route"
                        aria-hidden="true"
                        focusable="false"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={audience.icon}
                    />
                    <h3 class="mt-6 font-display text-2xl font-semibold text-foreground">{audience.title}</h3>
                    <p class="mt-3 max-w-prose text-foreground-muted">{audience.text}</p>
                </li>
            ))}
        </ul>
    </Section>

    <Section tone="warm" labelledby="open-heading">
        <div class="flex flex-col items-center text-center">
            {/* The route comes down from the band's top edge and ends at the ship */}
            <span aria-hidden="true" class="-mt-16 h-24 w-1 route-y sm:-mt-20 sm:h-28"></span>
            <img src="/assets/logo.svg" alt="" width="57" height="48" class="mt-4 h-12 w-auto" />

            <div class="mt-6">
                <SectionHeading id="open-heading">Open and free</SectionHeading>
            </div>
            <p class="mt-4 max-w-2xl text-lg text-foreground-secondary">
                Corsarium is open source and free to use. The code is public on GitHub under the MIT License, and you can follow the project, report problems, or contribute.
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-4">
                <Button href="/voyages">Begin your journey</Button>
                <Button href="https://github.com/GuilleCF/corsarium" variant="secondary">View the source code</Button>
            </div>
        </div>
    </Section>
</BaseLayout>
