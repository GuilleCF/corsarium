---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import VoyageSidebar from "@/components/VoyageSidebar.astro";
import LessonToc from "@/components/LessonToc.astro";
import { parseLessonId } from "@/lib/lessons";

interface Props {
    lesson: CollectionEntry<"lessons">;
}

export async function getStaticPaths() {
    const lessons = await getCollection("lessons");

    return lessons.map((entry) => {
        const { voyage, lesson } = parseLessonId(entry.id);

        return {
            params: { voyage, lesson },
            props: { lesson: entry },
        };
    });
}

const { lesson } = Astro.props;
const { voyage } = Astro.params;
const { Content, headings } = await render(lesson);
const hasToc = headings.length > 0;

const voyageLessons = (await getCollection("lessons", (entry) => parseLessonId(entry.id).voyage === voyage)).sort(
    (a, b) => a.data.order - b.data.order,
);

const currentIndex = voyageLessons.findIndex((entry) => entry.id === lesson.id);
const previousLesson = currentIndex > 0 ? voyageLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < voyageLessons.length - 1 ? voyageLessons[currentIndex + 1] : null;
---

<BaseLayout title={`Corsarium | ${lesson.data.title}`} description={lesson.data.description}>
    <div class={`grid items-start gap-8 px-4 py-16 sm:py-20 lg:grid-cols-[16rem_1fr] ${hasToc ? "xl:grid-cols-[16rem_1fr_16rem]" : ""}`}>
        <aside>
            <VoyageSidebar voyage={voyage} lessons={voyageLessons} currentLessonId={lesson.id} />
        </aside>
        <article class="max-w-3xl">
            <h1 class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
                {lesson.data.title}
            </h1>
            <div class="mt-8 text-foreground">
                <Content />
            </div>
            <nav aria-label="Lesson navigation" class="mt-12 flex items-center justify-between border-t border-border pt-6 text-sm">
                {previousLesson ? (
                    <a
                        href={`/voyages/${voyage}/${parseLessonId(previousLesson.id).lesson}`}
                        class="text-foreground-secondary hover:text-foreground"
                    >
                        ← {previousLesson.data.title}
                    </a>
                ) : <span />}
                {nextLesson ? (
                    <a
                        href={`/voyages/${voyage}/${parseLessonId(nextLesson.id).lesson}`}
                        class="text-foreground-secondary hover:text-foreground"
                    >
                        {nextLesson.data.title} →
                    </a>
                ) : <span />}
            </nav>
        </article>
        {hasToc && <LessonToc headings={headings} />}
    </div>
</BaseLayout>
