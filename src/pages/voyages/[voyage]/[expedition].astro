---
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
import ExpeditionToc from "@/components/ExpeditionToc.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { parseExpeditionId } from "@/lib/expeditions";

interface Props {
    expedition: CollectionEntry<"expeditions">;
}

export async function getStaticPaths() {
    const expeditions = await getCollection("expeditions");

    return expeditions.map((entry) => {
        const { voyage, expedition } = parseExpeditionId(entry.id);

        return {
            params: { voyage, expedition },
            props: { expedition: entry },
        };
    });
}

const { expedition } = Astro.props;
const { voyage } = Astro.params;
const { Content, headings } = await render(expedition);
const hasToc = headings.length > 0;

const voyageEntry = await getEntry("voyages", voyage);
if (!voyageEntry) {
    throw new Error(`No voyage metadata found for "${voyage}"`);
}

const voyageExpeditions = (await getCollection("expeditions", (entry) => parseExpeditionId(entry.id).voyage === voyage)).sort(
    (a, b) => a.data.order - b.data.order,
);

const currentIndex = voyageExpeditions.findIndex((entry) => entry.id === expedition.id);
const previousExpedition = currentIndex > 0 ? voyageExpeditions[currentIndex - 1] : null;
const nextExpedition = currentIndex < voyageExpeditions.length - 1 ? voyageExpeditions[currentIndex + 1] : null;
---

<BaseLayout title={`${expedition.data.title} | Corsarium`} description={expedition.data.description}>
    <div class="grid flex-1 lg:grid-cols-[auto_1fr] xl:grid-cols-[auto_1fr_18rem]">
        <aside>
            <Sidebar currentVoyage={voyage} currentExpeditionId={expedition.id} />
        </aside>
        <div class="min-w-0">
            <article class="mx-auto w-full max-w-3xl px-4 pb-16 pt-8 sm:pb-20">
            <Breadcrumbs voyage={voyage} voyageTitle={voyageEntry.data.title} expeditionTitle={expedition.data.title} />
            <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
                {expedition.data.title}
            </h1>
            <div class="prose prose-headings:font-display mt-8">
                <Content />
            </div>
            <nav aria-label="Expedition navigation" class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2">
                {previousExpedition && (
                    <a
                        href={`/voyages/${voyage}/${parseExpeditionId(previousExpedition.id).expedition}`}
                        class="group flex flex-col gap-1 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent"
                    >
                        <span class="text-sm text-foreground-muted"><span aria-hidden="true">← </span>Previous</span>
                        <span class="font-medium text-foreground group-hover:text-accent">{previousExpedition.data.title}</span>
                    </a>
                )}
                {nextExpedition && (
                    <a
                        href={`/voyages/${voyage}/${parseExpeditionId(nextExpedition.id).expedition}`}
                        class="group flex flex-col gap-1 rounded-xl border border-border bg-surface p-4 text-right transition-colors hover:border-accent sm:col-start-2"
                    >
                        <span class="text-sm text-foreground-muted">Next<span aria-hidden="true"> →</span></span>
                        <span class="font-medium text-foreground group-hover:text-accent">{nextExpedition.data.title}</span>
                    </a>
                )}
            </nav>
            </article>
        </div>
        {hasToc && <ExpeditionToc headings={headings} />}
    </div>
</BaseLayout>
