---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { parseExpeditionId } from "@/lib/expeditions";

export async function getStaticPaths() {
    const voyages = await getCollection("voyages");

    return voyages.map((entry) => ({
        params: { voyage: entry.id },
        props: { voyage: entry },
    }));
}

const { voyage } = Astro.params;
const { voyage: entry } = Astro.props;
const meta = entry.data;

const expeditions = (await getCollection("expeditions", (entry) => parseExpeditionId(entry.id).voyage === voyage)).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={`${meta.title} | Corsarium`} description={meta.description}>
    <div class="grid flex-1 lg:grid-cols-[auto_1fr] xl:grid-cols-[auto_1fr_18rem]">
        <aside>
            <Sidebar currentVoyage={voyage} />
        </aside>
        <div class="min-w-0">
            <div class="mx-auto w-full max-w-3xl px-4 pb-16 pt-8 sm:pb-20">
            <Breadcrumbs voyage={voyage} voyageTitle={meta.title} />
            <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
                {meta.title}
            </h1>
            <p class="mt-4 text-lg text-foreground-secondary">
                {meta.description}
            </p>

            {expeditions.length === 0 ? (
                <p class="mt-8 rounded-xl border border-dashed border-border-strong bg-surface p-6 text-foreground-muted">
                    The expeditions for this voyage are coming soon.
                </p>
            ) : (
            <ol class="mt-8 flex flex-col gap-1 rounded-xl border border-border bg-surface p-2">
                {expeditions.map((expedition) => (
                    <li>
                        <a
                            href={`/voyages/${voyage}/${parseExpeditionId(expedition.id).expedition}`}
                            class="group flex items-start gap-3 rounded-md px-3 py-3 hover:bg-surface-alt"
                        >
                            <svg
                                class="mt-1 h-4 w-4 shrink-0 text-accent"
                                aria-hidden="true"
                                focusable="false"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="12" cy="12" r="9"></circle>
                                <polygon points="14.5 9.5 10.5 10.5 9.5 14.5 13.5 13.5"></polygon>
                            </svg>
                            {/* The description is what this list adds over the sidebar, which only shows titles */}
                            <span class="flex flex-col gap-1">
                                <span class="font-medium text-foreground group-hover:text-accent">
                                    {expedition.data.order}. {expedition.data.title}
                                </span>
                                <span class="text-sm text-foreground-muted">{expedition.data.description}</span>
                            </span>
                        </a>
                    </li>
                ))}
            </ol>
            )}
            </div>
        </div>
    </div>
</BaseLayout>
