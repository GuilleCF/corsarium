---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/Card.astro";
import { parseExpeditionId } from "@/lib/expeditions";

const voyages = (await getCollection("voyages")).sort((a, b) => a.data.order - b.data.order);
const expeditions = await getCollection("expeditions");

function expeditionCount(voyageId: string) {
    return expeditions.filter((entry) => parseExpeditionId(entry.id).voyage === voyageId).length;
}
---

<BaseLayout title="All Voyages | Corsarium" description="Browse all Corsarium learning voyages.">
    <section class="mx-auto w-full max-w-4xl px-4 py-16 sm:py-20">
        <h1 class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
            All Voyages
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-foreground-muted">
            Choose a voyage to start learning.
        </p>

        <ul class="mt-10 grid gap-6 sm:grid-cols-2">
            {voyages.map((voyage) => {
                const count = expeditionCount(voyage.id);

                return (
                    <Card as="li" class="group relative p-8 transition-colors hover:border-accent has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-accent">
                        <h2 class="font-display text-xl font-semibold text-foreground">
                            {/* The ::after covers the whole card, so the full card is clickable while only the title is the link text */}
                            <a
                                href={`/voyages/${voyage.id}`}
                                class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-hidden group-hover:text-accent"
                            >
                                {voyage.data.title}
                            </a>
                        </h2>
                        <p class="mt-3 text-foreground-muted">{voyage.data.description}</p>
                        {count === 0 ? (
                            <p class="mt-4 inline-flex rounded-full border border-border bg-surface-alt px-3 py-1 text-xs font-medium text-foreground-secondary">
                                Coming soon
                            </p>
                        ) : (
                            <p class="mt-4 text-sm font-medium text-accent">
                                {count} {count === 1 ? "expedition" : "expeditions"}
                            </p>
                        )}
                    </Card>
                );
            })}
        </ul>
    </section>
</BaseLayout>
