---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const voyages = (await getCollection("voyages")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Corsarium | All Voyages" description="Browse all Corsarium learning voyages.">
    <section class="mx-auto w-full max-w-4xl px-4 py-16 sm:py-20">
        <h1 class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
            All Voyages
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-foreground-muted">
            Choose a voyage to start learning.
        </p>

        <ul class="mt-10 grid gap-6 sm:grid-cols-2">
            {voyages.map((voyage) => (
                <li class="rounded-xl border border-border-strong bg-surface p-8">
                    <h2 class="font-display text-xl font-semibold text-foreground">
                        <a href={`/voyages/${voyage.id}`} class="hover:text-accent">{voyage.data.title}</a>
                    </h2>
                    <p class="mt-3 text-foreground-muted">{voyage.data.description}</p>
                </li>
            ))}
        </ul>
    </section>
</BaseLayout>
