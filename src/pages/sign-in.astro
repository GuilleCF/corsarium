---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Corsarium | Sign in" description="Sign in to Corsarium.">
    <section class="px-4 py-16 text-center sm:py-20">
        <h1 class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">Sign in</h1>
        <p class="mx-auto mt-6 max-w-md text-lg text-foreground-muted">
            Accounts aren't available yet. Check back soon.
        </p>
    </section>
</BaseLayout>
