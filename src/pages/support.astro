---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Corsarium | Support us" description="Ways to support the Corsarium project.">
    <section class="px-4 py-16 sm:py-20">
        <div class="mx-auto max-w-3xl">
            <h1 class="font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">Support us</h1>
            <p class="mt-6 text-lg text-foreground-muted">
                Corsarium is open source and free to use. Ways to support the project are coming soon.
            </p>
        </div>
    </section>
</BaseLayout>
