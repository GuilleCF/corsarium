---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Corsarium | Page not found" description="The page you're looking for doesn't exist.">
    <section class="px-4 py-24 text-center">
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-accent">404</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
            Page not found
        </h1>
        <p class="mx-auto mt-4 max-w-md text-lg text-foreground-muted">
            The page you're looking for doesn't exist or has moved.
        </p>
        <Button href="/" class="mt-8">Back to home</Button>
    </section>
</BaseLayout>
