<button
    type="button"
    data-sidebar-toggle
    aria-controls="sidebar-panel"
    aria-expanded="true"
    aria-label="Hide contents"
    class="relative inline-flex h-9 shrink-0 items-center gap-2 rounded-full px-3 text-sm font-medium text-foreground hover:bg-surface-alt focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent after:absolute after:-inset-1 after:content-[''] lg:w-9 lg:justify-center lg:px-0"
>
    <svg
        class="h-5 w-5"
        aria-hidden="true"
        focusable="false"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
    >
        <rect x="3" y="3" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"></rect>
        <path d="M9 3v18" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    {/* Visible on mobile, where the closed sidebar is just this button; the accessible name ("Show contents") contains this word */}
    <span class="lg:hidden">Contents</span>
</button>
