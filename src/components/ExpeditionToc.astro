---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
---

<aside class="hidden xl:block">
    <nav aria-label="Expedition contents" class="sticky top-8 text-sm">
        <h2 class="font-display text-sm font-semibold text-foreground">On this page</h2>
        <ul class="mt-4 flex flex-col">
            {headings.map((heading) => (
                <li>
                    <a href={`#${heading.slug}`} class="block p-2.5 pl-4 text-foreground-secondary hover:text-foreground">
                        {heading.text}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</aside>
