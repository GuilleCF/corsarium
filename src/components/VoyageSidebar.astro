---
import type { CollectionEntry } from "astro:content";
import { parseLessonId } from "@/lib/lessons";

interface Props {
    voyage: string;
    lessons: CollectionEntry<"lessons">[];
    currentLessonId: string;
}

const { voyage, lessons, currentLessonId } = Astro.props;
---

<nav aria-label="Voyage lessons" class="hidden text-sm lg:block">
    <ol class="flex flex-col gap-1">
        {lessons.map((entry) => {
            const { lesson } = parseLessonId(entry.id);
            const isActive = entry.id === currentLessonId;

            return (
                <li>
                    <a
                        href={`/voyages/${voyage}/${lesson}`}
                        aria-current={isActive ? "page" : undefined}
                        class="block rounded-md px-3 py-2 text-foreground-secondary aria-[current=page]:bg-surface-alt aria-[current=page]:font-medium
aria-[current=page]:text-foreground hover:text-foreground"
                    >
                        {entry.data.order}. {entry.data.title}
                    </a>
                </li>
            );
        })}
    </ol>
</nav>

<details class="text-sm lg:hidden">
    <summary
        class="flex list-none items-center justify-between gap-2 rou text-foreground hover:bg-surface-alt[&::-webkit-details-marker]:hidden"
    >
        Lessons in this voyage
        <svg
            class="icon-chevron h-4 w-4 transition-transform duration-100 motion-reduce:transition-none"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <polyline points="9 6 15 12 9 18"></polyline>
        </svg>
    </summary>
    <nav aria-label="Voyage lessons" class="mt-1">
        <ol class="flex flex-col gap-1">
            {lessons.map((entry) => {
                const { lesson } = parseLessonId(entry.id);
                const isActive = entry.id === currentLessonId;

                return (
                    <li>
                        <a
                            href={`/voyages/${voyage}/${lesson}`}
                            aria-current={isActive ? "page" : undefined}
                            class="block rounded-md px-3 py-2 text-frent=page]:bg-surface-alt aria-[current=page]:font-mediumaria-[current=page]:text-foreground hover:text-foreground"
                        >
                            {entry.data.order}. {entry.data.title}
                        </a>
                    </li>
                );
            })}
        </ol>
    </nav>
</details>

<style>
    details[open] > summary .icon-chevron {
        transform: rotate(90deg);
    }
</style>
