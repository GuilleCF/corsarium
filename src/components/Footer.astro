---
const year = new Date().getFullYear();
---

<footer class="bg-surface-alt">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
        <div class="md:flex md:justify-between md:gap-8">
            <div class="max-w-sm">
                <a href="/" class="inline-flex items-center gap-2 text-lg font-semibold text-foreground">
                    <img src="/assets/logo.svg" alt="" width="33" height="28" class="h-7 w-auto" />
                    Corsarium
                </a>
                <p class="mt-2 text-sm text-foreground-muted">
                    An open platform for learning structural bioinformatics.
                </p>
            </div>
            <nav aria-label="Footer" class="mt-10 md:mt-0 md:min-w-40">
                <h2 class="text-sm font-semibold text-foreground">Explore</h2>
                <ul class="mt-4 flex flex-col gap-2 text-sm">
                    <li><a href="/voyages" class="text-foreground-secondary hover:text-foreground">All voyages</a></li>
                    <li><a href="/about" class="text-foreground-secondary hover:text-foreground">About</a></li>
                    <li><a href="/support" class="text-foreground-secondary hover:text-foreground">Support us</a></li>
                    <li><a href="https://github.com/GuilleCF/corsarium" class="text-foreground-secondary hover:text-foreground">Source code</a></li>
                </ul>
            </nav>
        </div>
        <div class="mt-12 border-t border-border pt-8">
            <p class="text-sm text-foreground-muted">
                &copy; {year} Corsarium. Code released under the{" "}
                <a href="https://github.com/GuilleCF/corsarium/blob/main/LICENSE" class="underline hover:text-foreground">MIT License</a>.
            </p>
        </div>
    </div>
</footer>
