---
interface Props {
    href: string;
    class?: string;
}

const { href, class: className } = Astro.props;
---

<a
    href={href}
    class:list={[
        "inline-flex items-center rounded-full bg-accent px-6 py-3 font-medium text-background transition-colors duration-200 hover:bg-accent-hover focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background",
        className,
    ]}
>
    <slot />
</a>
