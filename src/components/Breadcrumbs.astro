---
interface Props {
    voyage: string;
    voyageTitle: string;
    expeditionTitle: string;
}

const { voyage, voyageTitle, expeditionTitle } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
    <ol class="flex flex-wrap items-center gap-x-2 text-foreground-secondary">
        <li><a href="/" class="hover:text-foreground">Home</a></li>
        <li class="before:mr-2 before:content-['/']">
            <a href="/voyages" class="hover:text-foreground">Voyages</a>
        </li>
        <li class="before:mr-2 before:content-['/']">
            <a href={`/voyages/${voyage}`} class="hover:text-foreground">{voyageTitle}</a>
        </li>
        <li aria-current="page" class="before:mr-2 before:content-['/'] font-medium text-foreground">
            {expeditionTitle}
        </li>
    </ol>
</nav>
