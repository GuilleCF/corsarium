---
interface Props {
    voyage: string;
    voyageTitle: string;
    // Leave it out on a voyage's overview page: the voyage is then the current page
    expeditionTitle?: string;
}

const { voyage, voyageTitle, expeditionTitle } = Astro.props;

// The separator is an ::after on every item except the last, so a wrapped line ends with "/"
// instead of starting with one
const item = "not-last:after:ml-2 not-last:after:content-['/']";
---

<nav aria-label="Breadcrumb" class="text-sm">
    <ol class="flex flex-wrap items-center gap-x-2 text-foreground-secondary">
        <li class={item}><a href="/" class="hover:text-foreground">Home</a></li>
        <li class={item}>
            <a href="/voyages" class="hover:text-foreground">All voyages</a>
        </li>
        {expeditionTitle ? (
            <>
                <li class={item}>
                    <a href={`/voyages/${voyage}`} class="hover:text-foreground">{voyageTitle}</a>
                </li>
                <li aria-current="page" class:list={[item, "font-medium text-foreground"]}>
                    {expeditionTitle}
                </li>
            </>
        ) : (
            <li aria-current="page" class:list={[item, "font-medium text-foreground"]}>
                {voyageTitle}
            </li>
        )}
    </ol>
</nav>
