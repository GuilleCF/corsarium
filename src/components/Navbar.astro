---
import ThemeToggle from "@/components/ThemeToggle.astro"
---



<header class="bg-background">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="text-lg font-semibold text-foreground">Corsarium</a>

        <div class="hidden items-center gap-6 md:flex">
            <nav aria-label="Primary">
                <ul class="flex items-center gap-6">
                    <li><a href="/paths" class="text-foreground-secondary hover:text-foreground">All Paths</a></li>
                    <li><a href="/about" class="text-foreground-secondary hover:text-foreground">About</a></li>
                    <li><a href="/support" class="text-foreground-secondary hover:text-foreground">Support us</a></li>
                    <li><a href="/sign-in" class="text-foreground-secondary hover:text-foreground">Sign in</a></li>
                    <li><a href="/paths" class="rounded-full bg-accent px-4 py-1.5 font-medium text-background hover:bg-accent-hover">To set sail</a></li>
                </ul>
            </nav>
            <ThemeToggle />
            </div>

            <button
                id="mobile-menu-button"
                type="button"
                class="md:hidden"
                aria-expanded="false"
                aria-controls="mobile-menu"
                aria-label="Open menu"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
    </div>

    <nav id="mobile-menu" aria-label="Primary" class="md:hidden" hidden>
        <ul class="flex flex-col gap-1 px-4 pb-4">
            <li><a href="/paths" class="block py-2 text-foreground-secondary hover:text-foreground">All Paths</a></li>
            <li><a href="/about" class="block py-2 text-foreground-secondary hover:text-foreground">About</a></li>
            <li><a href="/support" class="block py-2 text-foreground-secondary hover:text-foreground">Support us</a></li>
            <li><a href="/sign-in" class="block py-2 text-foreground-secondary hover:text-foreground">Sign in</a></li>
            <li><a href="/paths" class="mt-1 inline-block rounded-full bg-accent px-4 py-1.5 font-medium text-background hover:bg-accent-hover">To set sail</a></li>
        </ul>
        <div class="border-t border-border px-4 py-3">
            <ThemeToggle />
        </div>
    </nav>
</header>

<script>
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");

    button?.addEventListener("click", () => {
        const isOpen = button?.getAttribute("aria-expanded") === "true";
        button?.setAttribute("aria-expanded", String(!isOpen));
        menu?.toggleAttribute("hidden", isOpen);
    });
</script>
